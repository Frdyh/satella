DATABASE_URL="mysql://usuario:password@localhost:3306/satella_db"
PORT=4000
FRONTEND_URL=http://localhost:3000

# Clave para firmar los tokens de sesión. Usa un valor largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-valor-aleatorio
JWT_EXPIRES_IN=8h

# Opcional, solo para el seed: números reales (con o sin indicativo) para la
# demo del canal de WhatsApp. Si no se ponen, el seed usa números de ejemplo.
# SEED_TEL_REPARTIDOR=3001112233
# SEED_TEL_OPERARIO=3004445566

# ─── Canal de WhatsApp (Cloud API de Meta) ───────────────────────────
# Se obtienen en developers.facebook.com → tu app → WhatsApp → Configuración de la API.
# Nunca subas los valores reales al repositorio. El token temporal del panel
# de pruebas de Meta caduca en pocas horas.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
# Secreto de la app (Configuración → Básica): valida la firma de cada webhook.
WA_APP_SECRET=
# Texto que inventas tú y pegas igual en el panel de Meta al configurar el webhook.
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v26.0
# Simulador para desarrollo y plan B de la demo. Deja "false" fuera de desarrollo:
# permite escribir haciéndose pasar por cualquier teléfono.
ENABLE_WA_SIMULATOR=false
