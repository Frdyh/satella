DATABASE_URL="mysql://usuario:password@localhost:3306/satella_db"
PORT=4000
FRONTEND_URL=http://localhost:3000

# Clave para firmar los tokens de sesión. Usa un valor largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-valor-aleatorio
JWT_EXPIRES_IN=8h

# Opcional, solo para el seed: números reales (con o sin indicativo) para la
# demo del canal de WhatsApp. Si no se ponen, el seed usa números de ejemplo.
# SEED_TEL_REPARTIDOR=3001112233
# SEED_TEL_OPERARIO=3004445566
